# Optional environment for database bootstrap/import scripts.
# Keep these values aligned with terraform/terraform.tfvars.
POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=marketpulse_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://marketpulse:marketpulse_local@localhost:5432/marketpulse

PRICE_REFRESH_INTERVAL_SECONDS=60
PRICE_STALE_AFTER_SECONDS=180
COINBASE_REQUEST_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO
